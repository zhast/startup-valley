{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-valley.local/contracts/asset-review.schema.json",
  "title": "Runtime art review",
  "type": "object",
  "required": ["schema_version", "id", "status", "reviewer", "reviewed_at", "camera_profile", "style_profile", "provenance", "artifacts", "bindings", "evidence", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "status": {"enum": ["candidate", "needs_redesign", "approved", "rejected"]},
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": "string"},
    "camera_profile": {"const": "office-square-grid-v1"},
    "style_profile": {
      "type": "object",
      "required": ["id", "path", "sha256", "application", "reference_board", "references"],
      "properties": {
        "id": {"const": "startup-valley-cozy-pixel-v1"},
        "path": {"const": "dev/art-catalogue/style-profile.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "application": {"enum": ["not_recorded", "generation_reference", "retrospective_review"]},
        "reference_board": {"$ref": "#/$defs/file"},
        "references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["kind", "note", "sources", "transform"],
      "properties": {
        "kind": {"enum": ["openai_imagegen", "code_native", "manual", "licensed", "legacy_unknown"]},
        "note": {"type": "string"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/file"}},
        "prompt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/file"}]},
        "generation_id": {"type": ["string", "null"]},
        "transform": {"type": "string"}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "evidence": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/file"}, {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["in_game", "test_report", "native_contact_sheet"]}}}]}},
    "checks": {
      "type": "object",
      "required": ["style", "camera", "scale", "anchor", "layering", "animation", "placement", "readability"],
      "additionalProperties": {"$ref": "#/$defs/check"}
    }
  },
  "$defs": {
    "file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "check": {"type": "object", "required": ["result", "note"], "properties": {"result": {"enum": ["pending", "passed", "not_applicable", "failed"]}, "note": {"type": "string"}}}
  },
  "$comment": "The runtime validator also requires real in-repository files, matching hashes, completed review notes and provenance appropriate to the source. A schema-valid candidate is not approval."
}
