{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-valley.local/contracts/protocol.schema.json",
  "title": "JSONL protocol envelope",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "method", "params"],
      "properties": {
        "kind": { "const": "request" },
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "method": {
          "enum": [
            "health",
            "bootstrap",
            "furnishing.update",
            "credential.status",
            "credential.set",
            "chat.history",
            "chat.send",
            "job.start",
            "job.resume",
            "job.steer",
            "job.approve",
            "job.cancel",
            "job.artifacts",
            "job.remember",
            "job.promote",
            "artifact.read",
            "studio.files",
            "studio.read",
            "clock.set",
            "hiring.complete", "milestone.evaluate", "milestone.complete", "milestone.override",
            "day.end", "game.save", "game.new"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "furnishing.update" } } }, "then": { "properties": { "params": { "$ref": "furnishing.schema.json#/$defs/update" } } } },
        { "if": { "properties": { "method": { "const": "hiring.complete" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["employeeId"], "properties": { "employeeId": { "enum": ["mira", "theo"] } } } } } },
        { "if": { "properties": { "method": { "enum": ["milestone.evaluate", "milestone.complete", "milestone.override"] } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["jobId"], "properties": { "jobId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" } } } } } },
        { "if": { "properties": { "method": { "const": "day.end" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["day"], "properties": { "day": { "type": "integer", "minimum": 1 } } } } } },
        { "if": { "properties": { "method": { "const": "game.new" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["confirmed"], "properties": { "confirmed": { "type": "boolean" } } } } } },
        { "if": { "properties": { "method": { "const": "game.save" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1280 }, "y": { "type": "number", "minimum": 0, "maximum": 720 }, "movementSeen": { "type": "boolean" }, "effectsVolume": { "type": "number", "minimum": 0, "maximum": 1 }, "ambienceVolume": { "type": "number", "minimum": 0, "maximum": 1 }, "attentionEmployeeId": { "enum": ["", "mira", "theo"] } } } } } }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "ok"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": { "type": "string", "maxLength": 4000 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jobId", "event"],
      "properties": {
        "kind": { "const": "event" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "event": { "$ref": "worker-event.schema.json" }
      }
    }
  }
}
