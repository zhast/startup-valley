{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-valley.local/contracts/protocol.schema.json",
  "title": "JSONL protocol envelope",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "method", "params"],
      "properties": {
        "kind": { "const": "request" },
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "method": {
          "enum": [
            "health",
            "bootstrap",
            "furnishing.update",
            "credential.status",
            "credential.set",
            "credential.grok.login.start",
            "credential.grok.login.poll",
            "credential.grok.login.cancel",
            "credential.grok.logout",
            "credential.grok.use_local",
            "chat.history",
            "chat.send",
            "job.start",
            "job.resume",
            "job.steer",
            "job.approve",
            "job.cancel",
            "job.artifacts",
            "job.remember",
            "job.promote",
            "artifact.read",
            "studio.files",
            "studio.read",
            "clock.set",
            "hiring.complete", "milestone.evaluate", "milestone.complete", "milestone.override",
            "chapter.continue",
            "day.end", "game.save", "game.new",
            "tycoon.start", "tycoon.release", "tycoon.train", "tycoon.research", "tycoon.buyUpgrade", "tycoon.expandOffice", "tycoon.acceptContract", "tycoon.patch", "tycoon.sequel", "tycoon.award", "tycoon.port", "tycoon.localize", "tycoon.buyEngine", "tycoon.takeLoan", "tycoon.signPublisher", "tycoon.bookBooth", "tycoon.takeTownDay", "tycoon.showPressDemo", "tycoon.makeTrailer", "tycoon.writeDiary", "tycoon.addFeature", "tycoon.setDayPlan", "tycoon.fixBugs", "tycoon.crunch", "tycoon.earlyAccess", "tycoon.cancelBuild", "tycoon.slipDay", "tycoon.pivot", "tycoon.playtest", "tycoon.assignTeam", "tycoon.researchSpike"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "method": { "const": "furnishing.update" } } }, "then": { "properties": { "params": { "$ref": "furnishing.schema.json#/$defs/update" } } } },
        { "if": { "properties": { "method": { "const": "hiring.complete" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["employeeId"], "properties": { "employeeId": { "enum": ["mira", "theo", "creative"] } } } } } },
        { "if": { "properties": { "method": { "const": "chapter.continue" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "enum": ["milestone.evaluate", "milestone.complete", "milestone.override"] } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["jobId"], "properties": { "jobId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" } } } } } },
        { "if": { "properties": { "method": { "const": "day.end" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["day"], "properties": { "day": { "type": "integer", "minimum": 1 } } } } } },
        { "if": { "properties": { "method": { "const": "game.new" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["confirmed"], "properties": { "confirmed": { "type": "boolean" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.start" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["topicId", "typeId"], "properties": {
          "topicId": { "enum": ["fitness", "trading", "sneakers", "reselling", "sports_betting", "cooking", "gaming", "dating", "study_notes", "crypto"] },
          "typeId": { "enum": ["course", "community", "template_pack", "coaching", "software", "newsletter"] },
          "staffIds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["founder", "mira", "theo", "creative"] } },
          "pricePercent": { "type": "integer", "enum": [80, 100, 120] },
          "marketing": { "enum": ["none", "small", "big"] },
          "engine": { "enum": ["none", "whop_kit"] },
          "focus": { "enum": ["balanced", "design", "tech", "hype"] },
          "audience": { "enum": ["everyone", "regulars", "newcomers"] },
          "size": { "enum": ["catalog", "short", "long"] }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.release" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.train" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["staffId", "stat"], "properties": {
          "staffId": { "enum": ["founder", "mira", "theo", "creative"] },
          "stat": { "enum": ["design", "tech", "hype"] }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.research" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {
          "kind": { "enum": ["topic", "type"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 64 }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.buyUpgrade" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.buyEngine" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["id"], "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.expandOffice" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.takeLoan" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.signPublisher" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.bookBooth" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.takeTownDay" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.showPressDemo" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.addFeature" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.setDayPlan" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["stat"], "properties": { "stat": { "enum": ["even", "design", "tech", "hype"] } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.fixBugs" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.crunch" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.earlyAccess" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.cancelBuild" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.slipDay" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.pivot" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["topicId", "typeId"], "properties": {
          "topicId": { "enum": ["fitness", "trading", "sneakers", "reselling", "sports_betting", "cooking", "gaming", "dating", "study_notes", "crypto"] },
          "typeId": { "enum": ["course", "community", "template_pack", "coaching", "software", "newsletter"] }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.playtest" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.assignTeam" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["staffIds"], "properties": {
          "staffIds": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["founder", "mira", "theo", "creative"] } }
        } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.researchSpike" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.makeTrailer" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.writeDiary" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.acceptContract" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "properties": {} } } } },
        { "if": { "properties": { "method": { "const": "tycoon.patch" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.sequel" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.award" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.port" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "tycoon.localize" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["productId"], "properties": { "productId": { "type": "string", "minLength": 2, "maxLength": 32, "pattern": "^p[1-9][0-9]*$" } } } } } },
        { "if": { "properties": { "method": { "const": "game.save" } } }, "then": { "properties": { "params": { "type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1280 }, "y": { "type": "number", "minimum": 0, "maximum": 720 }, "movementSeen": { "type": "boolean" }, "effectsVolume": { "type": "number", "minimum": 0, "maximum": 1 }, "ambienceVolume": { "type": "number", "minimum": 0, "maximum": 1 }, "attentionEmployeeId": { "enum": ["", "mira", "theo", "creative"] }, "architectureTheme": { "enum": ["office", "cafe", "loft", "studio", "evening"] } } } } } }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "ok"],
      "properties": {
        "kind": { "const": "response" },
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": { "type": "string", "maxLength": 4000 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jobId", "event"],
      "properties": {
        "kind": { "const": "event" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "event": { "$ref": "worker-event.schema.json" }
      }
    }
  }
}
