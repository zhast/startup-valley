{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://startup-valley.local/contracts/journey.schema.json",
  "title": "Worker-owned company Journey projection",
  "type": "object",
  "required": [
    "company",
    "player",
    "milestones",
    "candidates"
  ],
  "additionalProperties": false,
  "properties": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "location",
        "courtyardUnlocked",
        "visited",
        "metTheo",
        "opportunity"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "location": {
          "enum": [
            "office",
            "courtyard"
          ]
        },
        "courtyardUnlocked": {
          "type": "boolean"
        },
        "visited": {
          "type": "boolean"
        },
        "metTheo": {
          "type": "boolean"
        },
        "opportunity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "description",
            "topicId",
            "typeId",
            "status",
            "productId"
          ],
          "properties": {
            "id": {
              "const": "market_day_kit"
            },
            "title": {
              "type": "string",
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 400
            },
            "topicId": {
              "const": "reselling"
            },
            "typeId": {
              "const": "template_pack"
            },
            "status": {
              "enum": [
                "locked",
                "available",
                "accepted",
                "developing",
                "completed"
              ]
            },
            "productId": {
              "type": "string",
              "pattern": "^(|p[1-9][0-9]*)$"
            }
          }
        }
      }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cashCents",
        "earnedCents",
        "reputation",
        "chapter"
      ],
      "properties": {
        "cashCents": {
          "type": "integer"
        },
        "earnedCents": {
          "type": "integer",
          "minimum": 0
        },
        "reputation": {
          "type": "integer",
          "minimum": 0
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "player": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1280
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 720
        },
        "movementSeen": {
          "type": "boolean"
        },
        "effectsVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambienceVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attentionEmployeeId": {
          "enum": [
            "",
            "mira",
            "theo",
            "creative"
          ]
        },
        "architectureTheme": {
          "enum": [
            "office",
            "cafe",
            "loft",
            "studio",
            "evening"
          ]
        }
      },
      "additionalProperties": false
    },
    "milestones": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "employeeId",
          "state",
          "files",
          "criteria",
          "assignment",
          "rewardCents",
          "feeCents",
          "reputation",
          "availableFromDay",
          "jobId",
          "jobStatus",
          "overridden",
          "evaluation",
          "evaluationError"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "website",
              "ads",
              "incorporate",
              "brand",
              "apply"
            ]
          },
          "title": {
            "type": "string"
          },
          "employeeId": {
            "enum": [
              "mira",
              "theo",
              "creative"
            ]
          },
          "prerequisite": {
            "enum": [
              "website",
              "ads",
              "incorporate",
              "brand"
            ]
          },
          "state": {
            "enum": [
              "locked",
              "available",
              "active",
              "evaluating",
              "revision_required",
              "completed"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assignment": {
            "type": "string"
          },
          "rewardCents": {
            "type": "integer",
            "minimum": 0
          },
          "feeCents": {
            "type": "integer",
            "minimum": 0
          },
          "reputation": {
            "type": "integer",
            "minimum": 0
          },
          "availableFromDay": {
            "type": "integer",
            "minimum": 1
          },
          "jobId": {
            "type": "string"
          },
          "jobStatus": {
            "type": "string"
          },
          "overridden": {
            "type": "boolean"
          },
          "evaluationError": {
            "type": "string"
          },
          "evaluation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/evaluation"
              }
            ]
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "costCents",
          "available",
          "hired"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "mira",
              "theo",
              "creative"
            ]
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "costCents": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          },
          "hired": {
            "type": "boolean"
          }
        }
      }
    },
    "tycoon": { "$ref": "#/$defs/tycoon" },
    "daySummary": {
      "type": "object",
      "required": [
        "day",
        "entries",
        "completedWork",
        "earnedCents",
        "reputation",
        "aiSpend",
        "nextMilestone"
      ],
      "properties": {
        "day": {
          "type": "integer"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completedWork": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "earnedCents": {
          "type": "integer"
        },
        "reputation": {
          "type": "integer"
        },
        "aiSpend": {
          "type": "number",
          "minimum": 0
        },
        "nextMilestone": {
          "type": "string"
        },
        "dateLabel": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "tycoon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "salesWindowDays", "topics", "types", "fits", "staff", "trainingNotice", "researchPoints", "researchNotice", "upgradeNotice", "upgrades", "calendar", "payroll", "loan", "expo", "townDay", "rival", "office", "priceSteps", "marketingOptions", "engineNotice", "engine", "engineOptions", "focusOptions", "audienceOptions", "sizeOptions", "contract", "patchNotice", "developing", "history"],
      "properties": {
        "seed": { "type": "integer", "minimum": 1 },
        "salesWindowDays": { "type": "integer", "const": 4 },
        "topics": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/tycoonTopic" } },
        "types": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/tycoonType" } },
        "fits": { "type": "array", "maxItems": 60, "items": { "$ref": "#/$defs/tycoonFit" } },
        "staff": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/tycoonStaff" } },
        "trainingNotice": { "type": "string" },
        "letGoNotice": { "type": "string" },
        "researchPoints": { "type": "integer", "minimum": 0 },
        "researchNotice": { "type": "string" },
        "upgradeNotice": { "type": "string" },
        "upgrades": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/tycoonUpgrade" } },
        "calendar": { "$ref": "#/$defs/tycoonCalendar" },
        "payroll": { "$ref": "#/$defs/tycoonPayroll" },
        "catalog": { "$ref": "#/$defs/tycoonCatalog" },
        "loan": { "$ref": "#/$defs/tycoonLoan" },
        "expo": { "$ref": "#/$defs/tycoonExpo" },
        "townDay": { "$ref": "#/$defs/tycoonTownDay" },
        "rival": { "$ref": "#/$defs/tycoonRival" },
        "office": { "$ref": "#/$defs/tycoonOffice" },
        "priceSteps": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/tycoonPriceStep" } },
        "marketingOptions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/tycoonMarketing" } },
        "engineNotice": { "type": "string" },
        "engine": { "$ref": "#/$defs/tycoonEngine" },
        "engineOptions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/tycoonEngineOption" } },
        "focusOptions": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/tycoonFocusOption" } },
        "audienceOptions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/tycoonAudienceOption" } },
        "sizeOptions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/tycoonSizeOption" } },
        "dayPlanOptions": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/tycoonDayPlanOption" } },
        "contract": { "$ref": "#/$defs/tycoonContract" },
        "patchNotice": { "type": "string" },
        "developing": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/tycoonProduct" }] },
        "history": { "type": "array", "maxItems": 48, "items": { "$ref": "#/$defs/tycoonProduct" } }
      }
    },
    "tycoonPayroll": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cents", "payday", "notice"],
      "properties": {
        "cents": { "type": "integer", "minimum": 0 },
        "payday": { "type": "string", "minLength": 1 },
        "notice": { "type": "string" }
      }
    },
    "tycoonCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "name", "score", "checkCents", "payday", "list", "delist"],
      "properties": {
        "productId": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^p[1-9][0-9]*$" }] },
        "name": { "type": "string" },
        "score": { "type": "integer", "minimum": 0, "maximum": 10 },
        "checkCents": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "payday": { "type": "string", "minLength": 1 },
        "list": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productId", "enabled", "reason"],
          "properties": {
            "productId": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^p[1-9][0-9]*$" }] },
            "enabled": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        },
        "delist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "reason"],
          "properties": {
            "enabled": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        }
      }
    },
    "tycoonLoan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lender", "amountCents", "repayCents", "due", "outstanding"],
      "properties": {
        "lender": { "type": "string", "minLength": 1 },
        "amountCents": { "type": "integer", "const": 50000 },
        "repayCents": { "type": "integer", "const": 55000 },
        "due": { "type": "string", "minLength": 1 },
        "outstanding": { "type": "boolean" }
      }
    },
    "tycoonExpo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "costCents", "fans", "when", "booked"],
      "properties": {
        "name": { "type": "string", "const": "TownSquare Creator Fair" },
        "costCents": { "type": "integer", "const": 6000 },
        "fans": { "type": "integer", "const": 3 },
        "when": { "type": "string", "minLength": 1 },
        "booked": { "type": "boolean" }
      }
    },
    "tycoonTownDay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "costCents", "fans", "season", "taken"],
      "properties": {
        "name": { "type": "string", "const": "TownSquare Block Picnic" },
        "costCents": { "type": "integer", "const": 2000 },
        "fans": { "type": "integer", "const": 2 },
        "season": { "type": "string", "minLength": 1 },
        "taken": { "type": "boolean" }
      }
    },
    "tycoonRival": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shop", "topicId", "topicName", "unitPercent"],
      "properties": {
        "shop": { "enum": ["Pip's Pop-up", "Harbor Goods", "Lumen Kiosk", "Sable Shelf"] },
        "topicId": { "enum": ["cooking", "trading", "gaming", "study_notes"] },
        "topicName": { "enum": ["Cooking", "Trading", "Gaming", "Study Notes"] },
        "unitPercent": { "type": "integer", "const": 90 }
      }
    },
    "tycoonCalendar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "seasonName", "dayOfSeason", "year", "label", "favoredTopics", "event", "nextEvent"],
      "properties": {
        "season": { "enum": ["spring", "summer", "fall", "winter"] },
        "seasonName": { "enum": ["Spring", "Summer", "Fall", "Winter"] },
        "dayOfSeason": { "type": "integer", "minimum": 1, "maximum": 28 },
        "year": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 },
        "favoredTopics": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/tycoonFavoredTopic" }
        },
        "event": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/tycoonEvent" }] },
        "nextEvent": { "$ref": "#/$defs/tycoonNextEvent" }
      }
    },
    "tycoonFavoredTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "enum": ["fitness", "trading", "sneakers", "reselling", "sports_betting", "cooking", "gaming", "dating", "study_notes", "crypto"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "tycoonEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "blurb", "effect"],
      "properties": {
        "id": { "enum": ["creator_fair", "drop_day", "cohort_kickoff", "cozy_gift_guide"] },
        "name": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "effect": { "type": "string", "minLength": 1 }
      }
    },
    "tycoonNextEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "blurb", "effect", "season", "dayOfSeason", "daysUntil"],
      "properties": {
        "id": { "enum": ["creator_fair", "drop_day", "cohort_kickoff", "cozy_gift_guide"] },
        "name": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "effect": { "type": "string", "minLength": 1 },
        "season": { "enum": ["spring", "summer", "fall", "winter"] },
        "dayOfSeason": { "type": "integer", "minimum": 1, "maximum": 28 },
        "daysUntil": { "type": "integer", "minimum": 1 }
      }
    },
    "tycoonOffice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "name", "blurb", "desks", "next"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 2 },
        "name": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "desks": { "$ref": "#/$defs/tycoonOfficeDesks" },
        "next": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/tycoonOfficeNext" }] }
      }
    },
    "tycoonOfficeDesks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "total"],
      "properties": {
        "used": { "type": "integer", "minimum": 1 },
        "total": { "type": "integer", "minimum": 1 }
      }
    },
    "tycoonOfficeNext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "costCents", "requiredHires", "enabled", "reason"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "costCents": { "type": "integer", "minimum": 1 },
        "requiredHires": { "type": "integer", "minimum": 1 },
        "enabled": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "tycoonUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "blurb", "priceCents", "kind", "effect", "owned", "affordable"],
      "properties": {
        "id": { "enum": ["standing_desk", "second_monitor", "ring_light", "checkout_page"] },
        "name": { "type": "string", "minLength": 1 },
        "blurb": { "type": "string", "minLength": 1 },
        "priceCents": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["design", "tech", "hype", "price"] },
        "effect": { "type": "string", "minLength": 1 },
        "owned": { "type": "boolean" },
        "affordable": { "type": "boolean" }
      }
    },
    "tycoonTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "unlocked", "researchCost"],
      "properties": {
        "id": { "enum": ["fitness", "trading", "sneakers", "reselling", "sports_betting", "cooking", "gaming", "dating", "study_notes", "crypto"] },
        "name": { "type": "string", "minLength": 1 },
        "unlocked": { "type": "boolean" },
        "researchCost": { "type": "integer", "minimum": 0 }
      }
    },
    "tycoonType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "devDays", "priceCents", "design", "tech", "hype", "unlocked", "researchCost"],
      "properties": {
        "id": { "enum": ["course", "community", "template_pack", "coaching", "software", "newsletter"] },
        "name": { "type": "string", "minLength": 1 },
        "devDays": { "type": "integer", "minimum": 1 },
        "priceCents": { "type": "integer", "minimum": 0 },
        "design": { "type": "integer", "minimum": 0 },
        "tech": { "type": "integer", "minimum": 0 },
        "hype": { "type": "integer", "minimum": 0 },
        "unlocked": { "type": "boolean" },
        "researchCost": { "type": "integer", "minimum": 0 }
      }
    },
    "tycoonFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topicId", "typeId", "fit", "researchBonus"],
      "properties": {
        "topicId": { "enum": ["fitness", "trading", "sneakers", "reselling", "sports_betting", "cooking", "gaming", "dating", "study_notes", "crypto"] },
        "typeId": { "enum": ["course", "community", "template_pack", "coaching", "software", "newsletter"] },
        "fit": { "enum": ["great", "good", "okay", "bad"] },
        "researchBonus": { "type": "integer", "enum": [0, 6, 12] }
      }
    },
    "tycoonStaff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "design", "tech", "hype", "hired", "trainedToday", "training"],
      "properties": {
        "id": { "enum": ["founder", "mira", "theo", "creative"] },
        "name": { "type": "string", "minLength": 1 },
        "design": { "type": "integer", "minimum": 0, "maximum": 10 },
        "tech": { "type": "integer", "minimum": 0, "maximum": 10 },
        "hype": { "type": "integer", "minimum": 0, "maximum": 10 },
        "hired": { "type": "boolean" },
        "trainedToday": { "type": "boolean" },
        "training": { "$ref": "#/$defs/tycoonTraining" },
        "letGo": { "$ref": "#/$defs/tycoonLetGo" },
        "pace": { "$ref": "#/$defs/tycoonPace" }
      }
    },
    "tycoonTraining": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design", "tech", "hype"],
      "properties": {
        "design": { "$ref": "#/$defs/tycoonTrainOffer" },
        "tech": { "$ref": "#/$defs/tycoonTrainOffer" },
        "hype": { "$ref": "#/$defs/tycoonTrainOffer" }
      }
    },
    "tycoonLetGo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "reason"],
      "properties": {
        "enabled": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "tycoonPace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "enabled", "reason"],
      "properties": {
        "value": { "enum": ["full", "part"] },
        "enabled": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "tycoonTrainOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["costCents", "enabled"],
      "properties": {
        "costCents": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" }
      }
    },
    "tycoonPriceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["percent", "unitPercent", "label"],
      "properties": {
        "percent": { "type": "integer", "enum": [80, 100, 120] },
        "unitPercent": { "type": "integer", "enum": [80, 100, 120] },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "tycoonContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "client", "topicId", "typeId", "topicName", "typeName", "bonusCents", "status", "enabled", "reason"],
      "properties": {
        "id": { "enum": ["nova", "remy", "juniper", "pax", "kit", "lane"] },
        "client": { "type": "string", "minLength": 1 },
        "topicId": { "enum": ["fitness", "trading", "sneakers", "reselling", "sports_betting", "cooking", "gaming", "dating", "study_notes", "crypto"] },
        "typeId": { "enum": ["course", "community", "template_pack", "coaching", "software", "newsletter"] },
        "topicName": { "type": "string", "minLength": 1 },
        "typeName": { "type": "string", "minLength": 1 },
