{
  "name": "@startup-valley/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "live:openrouter": "npm run build && node --enable-source-maps dist/live-openrouter.js",
    "live:chapter": "npm run build && node --enable-source-maps dist/live-chapter.js",
    "eval:offline": "npm run build && node ../dev/eval/run.mjs",
    "eval:live": "npm run live:openrouter",
    "test": "npm run build && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@napi-rs/keyring": "2.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
